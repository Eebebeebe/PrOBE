# Keep the build context to what the image needs. The sprite data in
# packages/exporter/data/output (~460 MB) stays in: the browser suite renders
# with it. Everything below is regenerated inside the image or not needed.
.git
**/node_modules
packages/website/dist
packages/exporter/target
diagnostic-reports
playwright-report
test-results
.claude
.vscode
*.log
.env
